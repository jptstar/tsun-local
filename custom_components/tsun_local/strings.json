      "invalid_network": "Enter a valid IPv4 subnet between /24 and /32",
      "invalid_response": "The device responded, but the received data is not recognized.",
      "no_devices_found": "No compatible TSUN device was detected on this subnet.",
      "unknown_firmware": "This device firmware is not recognized automatically. Return to manual setup and choose ‘Forced detection — test protocols’, or select a protocol manually."
