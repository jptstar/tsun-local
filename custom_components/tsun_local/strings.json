{
  "title": "TSUN Local",
  "config": {
    "step": {
      "user": {
        "title": "Add a TSUN device",
        "description": "Search automatically for compatible TSUN devices on the network or add one manually.",
        "menu_options": {
          "discover": "Search for TSUN devices",
          "manual": "Add manually"
        }
      },
      "manual": {
        "title": "Add a device manually",
        "description": "Enter the device IP address. In most cases, leave protocol selection on ‘Automatic — based on firmware’. TSUN Local will also try to read the logger SN automatically.",
        "data": {
          "host": "IP address",
          "port": "Port",
          "logger_sn": "SN",
          "protocol": "Protocol selection method"
        }
      },
      "discover": {
        "title": "TSUN devices found",
        "description": "Select the TSUN device you want to add. TSUN Local checks the firmware so that only devices using supported protocols are offered.",
        "data": {
          "host": "Discovered address",
          "port": "Port",
          "logger_sn": "SN"
        }
      },
      "discover_network": {
        "title": "Search another subnet",
        "description": "No compatible TSUN device was detected automatically. Enter the IPv4 subnet to scan, for example 192.168.1.0/24. The scan is limited to 254 addresses.",
        "data": {
          "discovery_network": "IPv4 subnet",
          "port": "Port"
        }
      },
      "reconfigure": {
        "title": "Update connection",
        "description": "Change the IP address or TCP port. The numeric SN remains the permanent connection identifier.",
        "data": {
          "host": "IP address",
          "port": "Port"
        }
      }
    },
    "error": {
      "cannot_connect": "Unable to communicate with the device. Check that it is online and reachable from Home Assistant.",
      "cannot_detect_logger_sn": "The logger SN could not be detected automatically. Enter the number shown as Device serial number on the local status page or printed on the device label.",
      "invalid_network": "Enter a valid IPv4 subnet between /24 and /32",
      "invalid_response": "The device responded, but the received data is not recognized.",
      "no_devices_found": "No compatible TSUN device was detected on this subnet.",
      "unknown_firmware": "This device firmware is not recognized automatically. Return to manual setup and choose ‘Forced detection — test protocols’, or select a protocol manually."
    },
    "abort": {
      "already_configured": "This micro-inverter is already configured",
      "all_devices_configured": "All detected micro-inverters are already configured",
      "no_devices_found": "No compatible TSUN device was detected on the scanned networks."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Polling settings",
        "description": "Configure polling for this micro-inverter. If Adaptive polling is disabled, the intervals below keep the usual fixed behavior. If it is enabled, they become the limits used by the algorithm: the normal interval is the regular cadence, the error interval sets the first retry delay without going below the normal cadence, and the offline/night interval is applied as soon as the configured consecutive-failure threshold is reached. Between these limits, TSUN Local automatically builds progressive backoff steps. As soon as a poll succeeds again, the micro-inverter is marked online immediately and the interval progressively returns to normal. Changing the intervals or the failure threshold therefore changes the adaptive steps automatically. Wi-Fi signal is diagnostic only and never changes the polling cadence by itself.",
        "data": {
          "adaptive_polling": "Adaptive polling",
          "scan_interval": "Normal polling interval",
          "error_scan_interval": "Retry interval after error",
          "offline_scan_interval": "Offline/night polling interval",
          "failure_threshold": "Failures before offline"
        }
      }
    }
  },
